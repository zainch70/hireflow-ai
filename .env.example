# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase Postgres connection string for Drizzle)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Google Gemini
# Required by Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Optional: comma-separated key pool for future rotation/fallback
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
