# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Project Settings → General / Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Project Settings → API Keys → Secret key (server only)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Database — prefer Session pooler (not Direct db.*.supabase.co)
# Project Settings → Database → Connection string → URI → Session pooler
# Append ?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Google Gemini
# Required by Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Optional: comma-separated key pool for future rotation/fallback
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
